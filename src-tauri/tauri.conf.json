{
  "productName": "HERA",
  "version": "0.1.0",
  "identifier": "com.kilcoyne.hera",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HERA — Hyperdimensional Engine for Reasoning and Analysis",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Matt Kilcoyne",
    "category": "Productivity",
    "shortDescription": "Hyperdimensional semantic engine — offline, private, any data source",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
